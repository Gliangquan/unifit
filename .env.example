# UniFit local / production shared environment template
# Copy to .env for docker compose deployment, or export vars before local startup.

TZ=Asia/Shanghai
SERVER_PORT=19921

# Backend datasource
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3307/unifit?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useUnicode=true&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# Redis
SPRING_REDIS_HOST=127.0.0.1
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=

# RabbitMQ
SPRING_RABBITMQ_HOST=127.0.0.1
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# MinIO
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_PUBLIC_ENDPOINT=http://107.148.176.142:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=unifit

# JWT
JWT_SECRET=unifit-jwt-secret-please-change-in-production-2026-very-long

# Frontend build-time API settings
FRONTEND_API_BASE_URL=/api
FRONTEND_WS_BASE_URL=/ws
UNIAPP_BASE_URL=/api
